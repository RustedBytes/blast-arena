{
  "name": "blast-arena-client",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Browser client for Blast Arena, compiled from client/*.ts to static/js/*.js",
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . --watch",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint client",
    "check": "tsc -p . --noEmit && eslint client"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
