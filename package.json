{
  "name": "blast-arena-client",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "description": "Browser client for Blast Arena: client/*.ts bundled into one minified file per page in static/js/",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:dev": "node scripts/build-client.mjs --dev",
    "watch": "node scripts/build-client.mjs --watch",
    "typecheck": "tsc -p .",
    "lint": "eslint client scripts",
    "check": "tsc -p . && eslint client scripts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "browserslist": "^4.29.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-compat": "^7.0.2",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.32",
    "sass": "^1.108.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "browserslist": [
    "cover 95%",
    "not dead"
  ],
  "overrides": {
    "minimatch": "^11.0.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher": false
  }
}
